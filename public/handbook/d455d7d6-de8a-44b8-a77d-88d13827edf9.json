ent":[{"type":"table_cell","attrs":{"id":"196f6980-9cfe-4ecf-acd5-62222917d300","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"f260dfef-ebe3-4d91-ae39-3a40827efaf7"},"content":[{"type":"text","text":"Безопасность жизнедеятельности"}]}]},{"type":"table_cell","attrs":{"id":"c66ad2e7-dcf8-4c51-8b60-82b601e7cc51","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"ab8f18a4-0fcb-4034-a77c-c2fe7359ec7f"},"content":[{"type":"text","text":"1"}]}]}]},{"type":"table_row","attrs":{"id":"546f2700-6ab6-4cd2-860b-2ed035f4e017"},"content":[{"type":"table_cell","attrs":{"id":"8a271085-0429-4770-ba83-4de08625124c","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"850ac3bf-d4ae-4be9-954d-187164cc943e"},"content":[{"type":"text","text":"Физическая культура"}]}]},{"type":"table_cell","attrs":{"id":"8585f3af-5216-4da0-ab97-96bd26c98eb2","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"6a9ec9bf-a5b6-402d-9461-f330a4692e41"},"content":[{"type":"text","text":"4"}]}]}]}]},{"type":"bullet_list","attrs":{"id":"2908b25c-1215-4ccf-88cb-19771c62aefc"},"content":[{"type":"list_item","attrs":{"id":"26a5f1ae-fe35-41b7-b0e5-0c459ce8bb1f"},"content":[{"type":"paragraph","attrs":{"id":"ce71b4ae-1fcf-4394-b085-4dec49af0579"},"content":[{"type":"text","text":"Примечание 1","marks":[{"type":"bold"}]},{"type":"text","text":" Требование предмета «Физическая культура» можно выполнить, посещая индивидуальные тренировки или групповые тренировки"}]}]},{"type":"list_item","attrs":{"id":"24f9d83b-b746-4d36-a372-419019e6c263"},"content":[{"type":"paragraph","attrs":{"id":"60e1ac84-7d98-44a3-a5d3-60f286562835"},"content":[{"type":"text","text":"Примечание 2","marks":[{"type":"bold"}]},{"type":"text","text":" Требование предмета «Безопасность жизнедеятельности» можно выполнить, пройдя интенсивное обучение (буткемп) и закрепив полученные знания прохождением тестирования"}]}]}]}]}]},{"type":"heading","attrs":{"id":"80d7b115-5007-43da-9a86-564e3b04a398","level":2},"content":[{"type":"text","text":"Ответы на частые вопросы","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"f4f59f10-db94-407b-a09a-ffd658125a21"},"content":[{"type":"list_item","attrs":{"id":"96738640-1058-415b-938b-553375360bb2"},"content":[{"type":"paragraph","attrs":{"id":"d604489e-9c91-454e-b367-87b578138db8"},"content":[{"type":"text","text":"Как и когда происходит выбор курсов на первый семестр?","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"059cd9c8-11e6-4d77-8abc-6da35c9ccd27"},"content":[{"type":"text","text":"Обучение в ЦУ начинается с недели онбординга, на которой мы проводим распределительные контесты и знакомим абитуриентов с процессами и содержанием учебной программы. Во время этой недели студенты-первокурсники сделают первичный выбор предметов на первый семестр. После этого у них есть две недели, чтобы изменить свой выбор."}]}]},{"type":"list_item","attrs":{"id":"ec37673d-9381-4118-997b-1b0df82d5842"},"content":[{"type":"paragraph","attrs":{"id":"0bfd77b7-80d9-42dc-a7d7-c926c2e589bf"},"content":[{"type":"text","text":"Программа подразумевает ","marks":[{"type":"bold"}]},{"type":"text","text":"выбор уровня","marks":[{"type":"link","attrs":{"href":"/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/835a47ef-a557-472e-95c8-8b4484fd2b6f"}},{"type":"bold"}]},{"type":"text","text":" прохождения предметов на первом курсе. Как этот выбор будет происходить?","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"488cf518-febc-4cb2-8bb8-09044acafbc8"},"content":[{"type":"text","text":"Выбор уровня происходит по-разному на разных курсах."}]},{"type":"paragraph","attrs":{"id":"488decbf-c0a1-4a99-aef0-d1f7795547fe"},"content":[{"type":"text","text":"Вариант 1. Распределительный контест","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"341497e8-a4df-4365-8181-6bf2f165d0a8"},"content":[{"type":"text","text":"На математических курсах и курсе «Разработка на Python» распределение по уровням будет происходить с помощью входного контеста. На неделе онбординга (первая неделя сентября) все студенты напишут работы по математике и программированию. После этого мы распределим студентов по уровням в зависимости от результатов контестов, баллов ЕГЭ и пожеланий студентов."}]},{"type":"blockquote","attrs":{"id":"e4ea2341-684c-43f0-b1dd-67a8bf1fd7a6"},"content":[{"type":"paragraph","attrs":{"id":"d2b29c05-a49f-4909-82bc-b3631b1a28d5"},"content":[{"type":"text","text":"В течение первых нескольких недель у студентов будет возможность повысить или понизить свой уровень."}]}]},{"type":"paragraph","attrs":{"id":"609a573b-b7ab-4646-a499-afcb6ba3b534"},"content":[{"type":"text","text":"Вариант 2. Выбор студентов","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"8475e456-bead-4bd1-aed4-a6eaab3b3b8b"},"content":[{"type":"text","text":"Подробности читай на "},{"type":"text","text":"специальной странице","marks":[{"type":"link","attrs":{"href":"/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/835a47ef-a557-472e-95c8-8b4484fd2b6f"}}]}]}]},{"type":"list_item","attrs":{"id":"3ef4f343-84b1-42e1-9509-9616a70d34b9"},"content":[{"type":"paragraph","attrs":{"id":"47c68994-e54c-4c66-ab34-e2b1f523b795"},"content":[{"type":"text","text":"Можно ли перейти с одного направления подготовки (МКН, БИ) на другое?","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"506c0f34-7c7c-436e-9a45-45b02f882d0d"},"content":[{"type":"text","text":"Да. Неважно, на какое направление подготовки ты поступаешь в ЦУ. В течение первых двух лет тебе нужно будет выбрать свой мейджор и мы переведем тебя на соответствующее направление подготовки: 02.03.01 «Математика и компьютерные науки» или 38.03.05 «Бизнес-информатика»."}]}]},{"type":"list_item","attrs":{"id":"327c1360-43e9-4869-870a-2dbbb96969b1"},"content":[{"type":"paragraph","attrs":{"id":"86dbf6c9-af11-4d35-a51f-def8659b4677"},"content":[{"type":"text","text":"Я уже знаю некоторые предметы первого курса. Что мне делать?","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"82bcf60a-99c4-4cd4-9352-6c7916d60ce5"},"content":[{"type":"text","text":"Если ты уже хорошо знаешь некоторые дисциплины, сообщи об этом своему куратору. Мы оценим уровень твоих знаний и найдем индивидуальные возможности для развития."}]}]}]}]}]}