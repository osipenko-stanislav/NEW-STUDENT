","text":"Справка должна содержать:"}]},{"type":"bullet_list","attrs":{"id":"8f0b306b-43b9-49f6-b7aa-b712c64b291a"},"content":[{"type":"list_item","attrs":{"id":"5a7ce154-a9b5-40e4-b651-b2ffaae7336b"},"content":[{"type":"paragraph","attrs":{"id":"19b0fcc3-623f-4516-a4de-c2197b8a5132"},"content":[{"type":"text","text":"твои Ф. И. О."}]}]},{"type":"list_item","attrs":{"id":"dfdc06eb-b301-4835-9905-685f4a783fd7"},"content":[{"type":"paragraph","attrs":{"id":"31f6f2c3-3fa7-4187-8214-5b32a135d596"},"content":[{"type":"text","text":"название болезни"}]}]},{"type":"list_item","attrs":{"id":"15999415-e175-4ada-8ffa-d62e243ae33e"},"content":[{"type":"paragraph","attrs":{"id":"fa7c414a-7b15-4331-8c98-61cc90cc4f5d"},"content":[{"type":"text","text":"срок болезни"}]}]},{"type":"list_item","attrs":{"id":"9a5a36cc-c1f2-45cc-95c3-1925bcb5bfe9"},"content":[{"type":"paragraph","attrs":{"id":"ccf33378-70e2-4cb8-a35d-211f1024145f"},"content":[{"type":"text","text":"печать поликлиники"}]}]}]},{"type":"paragraph","attrs":{"id":"5bd835dd-a24b-4020-9d3d-062bf4c8b983"},"content":[{"type":"text","text":"Где получить справку","marks":[{"type":"bold"}]}]},{"type":"layoutSection","attrs":{"id":"e7b8043c-0b93-4065-af50-849520edb773"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"69b1abed-02f4-4fa2-aed5-235fdf9bc105"},"content":[{"type":"text","text":"В поликлинике"}]},{"type":"paragraph","attrs":{"id":"12bb2fde-ec7e-4fdc-b593-8b34d4db46b1"},"content":[{"type":"text","text":"В начале болезни обратись к врачу в поликлинике, а после выздоровления возьми справку."}]}]},{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"cb44e4e9-218f-4111-b9a0-6e5ab7425217"},"content":[{"type":"text","text":"У терапевта в кампусе"}]},{"type":"paragraph","attrs":{"id":"f2e7f278-e331-4d0e-9b29-6df0ff046bef"},"content":[{"type":"text","text":"Если почувствуешь себя плохо во время занятий, обратись к терапевту, чтобы открыть справку."}]},{"type":"paragraph","attrs":{"id":"ff41f96c-d746-4eb0-b570-e86b1d11f4e7"},"content":[{"type":"text","text":"Кампус: улица Гашека, 7/1, кабинет В404."},{"type":"hardBreak"},{"type":"text","text":"Центральный телеграф: сектор S, 3-й этаж."},{"type":"hardBreak"},{"type":"text","text":"Кампус-отель «Диск»: кабинет 131."}]},{"type":"paragraph","attrs":{"id":"6848d003-0b4e-49c0-a2dc-530b8a9c3bc7"},"content":[{"type":"text","text":"Время работы терапевта: пн. — пт. с 10:00 до 19:00, перерыв с 14:00 до 15:00."}]}]}]},{"type":"panel","attrs":{"id":"d096dc8c-e44a-4120-8ad7-46615a4a32eb","type":"warning"},"content":[{"type":"paragraph","attrs":{"id":"6207c927-03e8-474f-8c30-608cc0d6d151"},"content":[{"type":"text","text":"Только при наличии справки болезнь считается официальной причиной пропуска занятий, контрольных работ и экзаменов. При этом Late Days не начисляются, а дедлайны не переносятся."}]}]},{"type":"paragraph","attrs":{"id":"50a2fd48-1bd3-42bc-873e-44ef8bc2cac3"},"content":[{"type":"text","text":"Нам важно знать, что с тобой происходит. Если ты пропускаешь занятия из-за болезни, обязательно сообщи об этом. Так мы корректно отметим отсутствие и поймем, нужна ли дополнительная поддержка. Если у тебя вирусная инфекция, мы сможем быстрее отреагировать и снизить риск распространения болезни. "}]},{"type":"paragraph","attrs":{"id":"4b8257b6-0bca-4052-89eb-b788babdc8a4"},"content":[{"type":"text","text":"Чтобы сообщить об уважительной причине пропуска, прикрепи справку в Маяке."}]},{"type":"mediaWrapper","attrs":{"id":"584ad71c-0cfa-42dd-835a-cb529a603b26"},"content":[{"type":"media","attrs":{"id":"206ef2f9-f44d-4fd3-8f5a-c96b8a4a9d0d","_meta":{"title":"1.png","size":644096,"simpleType":"image"},"_mimetype":"image/png","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=206ef2f9-f44d-4fd3-8f5a-c96b8a4a9d0d&source_id=3a61975c-6fed-441e-a604-899f3ba07859&source_type=article&bx_token=&account_slug=default"}}]},{"type":"heading","attrs":{"id":"02242789-80e3-46c8-9ee5-1547214159ef","level":3},"content":[{"type":"text","text":"Электронная справка","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"564d851d-5ed3-438e-a853-1530f0c6d938"},"content":[{"type":"text","text":"Во многих поликлиниках и больницах выдаются только электронные справки. Их нужно скачать и загрузить в Маяк."}]},{"type":"paragraph","attrs":{"id":"25f7b500-475a-4f48-bd9c-7e02128b0eac"},"content":[{"type":"text","text":"Как получить электронную справку","marks":[{"type":"bold"}]}]},{"type":"ordered_list","attrs":{"id":"fcdb9035-79fe-426a-8a19-6dfa77b310ea","start":1},"content":[{"type":"list_item","attrs":{"id":"947017e1-5104-4b05-bacb-58a4b279236b"},"content":[{"type":"paragraph","attrs":{"id":"cbde86b5-596c-4d9f-be98-6541274344b4"},"content":[{"type":"text","text":"Зайди на сайт "},{"type":"text","text":"mos.ru","marks":[{"type":"link","attrs":{"href":"https://lk.emias.mos.ru/medical-records"}}]},{"type":"text","text":"."}]}]},{"type":"list_item","attrs":{"id":"b5716e5e-70a3-42c8-a50f-58faf479aa6f"},"content":[{"type":"paragraph","attrs":{"id":"1bca8900-68ae-47c7-9ab7-b7c4436f8b53"},"content":[{"type":"text","text":"Авторизуйся через Госуслуги."}]}]},{"type":"list_item","attrs":{"id":"58ea138c-4c5f-4810-a378-401ef9e32e02"},"content":[{"type":"paragraph","attrs":{"id":"c3ad9306-cd2a-433e-b1f3-be2f37cfd9d4"},"content":[{"type":"text","text":"Открой раздел «Мои справки и медзаключения»."}]}]},{"type":"list_item","attrs":{"id":"40b1feb8-0294-47b4-84d6-a9c42856cf85"},"content":[{"type":"paragraph","attrs":{"id":"ddd0a756-8132-4231-b0a3-ca9bcd4438e2"},"content":[{"type":"text","text":"В разделе «Справки» нажми «Просмотр»."}]}]},{"type":"list_item","attrs":{"id":"828a4c8e-7933-418a-a5ce-cc232e6b27f5"},"content":[{"type":"paragraph","attrs":{"id":"1996d376-9b94-41af-8e80-381d784e27d7"},"content":[{"type":"text","text":"Скачай справку."}]}]}]},{"type":"mediaWrapper","attrs":{"id":"632c3b60-8aaf-467e-823a-a3779f1df727"},"content":[{"type":"media","attrs":{"id":"7ebbf6a2-be90-4ba1-81b8-1bd08a316019","_meta":{"title":"2.png","size":1516544,"simpleType":"image"},"_mimetype":"image/png","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=7ebbf6a2-be90-4ba1-81b8-1bd08a316019&source_id=3a61975c-6fed-441e-a604-899f3ba07859&source_type=article&bx_token=&account_slug=default"}}]},{"type":"mediaWrapper","attrs":{"id":"57cbda2a-1c3e-410f-afa4-558269e50b94"},"content":[{"type":"media","attrs":{"id":"d406de6d-7b18-4853-893f-b7366e7c2952","_meta":{"title":"3.png","size":1533952,"simpleType":"image"},"_mimetype":"image/png","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=d406de6d-7b18-4853-893f-b7366e7c2952&source_id=3a61975c-6fed-441e-a604-899f3ba07859&source_type=article&bx_token=&account_slug=default"}}]},{"type":"mediaWrapper","attrs":{"id":"f34a10eb-fb8a-40e7-83a8-a59b45b2c08a"},"content":[{"type":"media","attrs":{"id":"70853ae3-379d-497e-bbc9-4840826e5686","_meta":{"title":"4.png","size":1301504,"simpleType":"image"},"_mimetype":"image/png","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=70853ae3-379d-497e-bbc9-4840826e5686&source_id=3a61975c-6fed-441e-a604-899f3ba07859&source_type=article&bx_token=&account_slug=default"}}]},{"type":"heading","attrs":{"id":"2681554c-412a-4bb5-a2c7-f2f9979acf13","level":2},"content":[{"type":"text","text":"Заявление-согласие на занятия спортом","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"dae88069-72f4-4a78-a38e-4ccfe738a40b"},"content":[{"type":"text","text":"Кому нужна: ","marks":[{"type":"bold"}]},{"type":"text","text":"студентам "},{"type":"text","text":"III группы здоровья"}]},{"type":"paragraph","attrs":{"id":"cb612ae6-63d4-4c0c-a200-04495f256cf2"},"content":[{"type":"text","text":"Если ты хочешь закрыть курс физической культуры посещением тренировок, тебе необходимо подать заявление. Как это сделать:"}]},{"type":"ordered_list","attrs":{"id":"ac9f9c9c-96c0-4669-8ee1-fce75dfde4bd","start":1},"content":[{"type":"list_item","attrs":{"id":"175bda3e-a063-4022-991b-0f571cdc8b3f"},"content":[{"type":"paragraph","attrs":{"id":"98019317-f1fe-42f3-8663-3be14a175400"},"content":[{"type":"text","text":"Скачай заявление в Маяке: "},{"type":"text","text":"«Документы, справки и заявления» → «Заявление-согласие на занятия спортом»","marks":[{"type":"bold"}]},{"type":"text","text":". Обрати внимание: в документе есть два шаблона — для студентов старше 18 лет и для тех, кому еще нет 18. Выбери подходящий вариант."}]}]},{"type":"list_item","attrs":{"id":"3098812c-556b-4b53-95f5-5c5efbd26af8"},"content":[{"type":"paragraph","attrs":{"id":"340b3203-cfd5-46a9-9f00-1f2a60c192db"},"content":[{"type":"text","text":"С заполненным заявлением подойди к терапевту в кабинет "},{"type":"text","text":"В404","marks":[{"type":"bold"}]},{"type":"text","text":". Врач задаст тебе вопросы о состоянии здоровья и рассмотрит возможность допуска к занятиям. Заранее подготовь медицинские документы, на основании которых тебе была установлена "},{"type":"text","text":"III группа здоровья","marks":[{"type":"bold"}]},{"type":"text","text":"."}]}]},{"type":"list_item","attrs":{"id":"268958e0-f076-48a8-b07d-189475e9900d"},"content":[{"type":"paragraph","attrs":{"id":"9c8824b8-ba59-4310-a053-0249c356fd92"},"content":[{"type":"text","text":"После проверки документов врач примет решение по твоему заявлению. По медицинским показаниям заявление может быть отклонено в целях безопасности и сохранения твоего здоровья."}]}]}]},{"type":"heading","attrs":{"id":"f1095e86-ad21-4de6-9626-18fd5220ae0f","level":2},"content":[{"type":"text","text":"Ответы на частые вопросы","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"e4334fe5-0af4-4ad7-8798-600c3b509324"},"content":[{"type":"text","text":"По остальным вопросам обращайся к своему куратору в Time."}]},{"type":"expandSection","attrs":{"id":"336c6367-06b2-44f9-9c61-513b35f89055"},"content":[{"type":"expandTitle","content":[{"type":"text","text":"Можно ли принести копию справки? ","marks":[{"type":"bold"}]}]},{"type":"expandContent","content":[{"type":"paragraph","attrs":{"id":"14148707-0b94-43a7-b2be-b8b3417014b1"},"content":[{"type":"text","text":"Да, если копия заверена печатью медицинской организации."}]}]}]},{"type":"expandSection","attrs":{"id":"88e2cabc-e7b4-4ef6-8d10-1fde37041b3f"},"content":[{"type":"expandTitle","content":[{"type":"text","text":"Группа по физкультуре указана в моей справке СЭМД-196. Нужна ли отдельная справка? ","marks":[{"type":"bold"}]}]},{"type":"expandContent","content":[{"type":"paragraph","attrs":{"id":"26dda124-8ade-47d4-9828-0e0a1bea1577"},"content":[{"type":"text","text":"Если у тебя есть оригинал справки СЭМД-196, в которой правильно указана группа для занятий физической культурой, отдельную справку получать не нужно."}]}]}]},{"type":"expandSection","attrs":{"id":"f690346c-c2ff-4062-9a59-f70fd6b56a20"},"content":[{"type":"expandTitle","content":[{"type":"text","text":"Где получить сведения о вакцинации? ","marks":[{"type":"bold"}]}]},{"type":"expandContent","content":[{"type":"paragraph","attrs":{"id":"645f188f-57f8-4892-8953-209150790458"},"content":[{"type":"text","text":"Если у тебя нет прививочной карты, получи ее в своей поликлинике. Она хранится в истории развития ребенка (форма №112/у) или медицинской карте амбулаторного больного (форма №25/у). "}]}]}]},{"type":"expandSection","attrs":{"id":"62fa6d42-6f74-4091-800a-88ee1ed4e0a6"},"content":[{"type":"expandTitle","content":[{"type":"text","text":"Сколько действует флюорография или рентгеновский снимок? ","marks":[{"type":"bold"}]}]},{"type":"expandContent","content":[{"type":"paragraph","attrs":{"id":"b9c42a51-fd75-4b1c-906c-e919a2f8ecd6"},"content":[{"type":"text","text":"Один год. Если на момент предоставления справки до конца срока остается месяц, обследование нужно пройти заново и принести актуальный результат."}]}]}]},{"type":"expandSection","attrs":{"id":"37da31e3-f662-4a3d-8bd3-d2f8467054bd"},"content":[{"type":"expandTitle","content":[{"type":"text","text":"Обязательна ли вакцина от кори?","marks":[{"type":"bold"}]}]},{"type":"expandContent","content":[{"type":"paragraph","attrs":{"id":"310165fc-fce0-41ec-b908-07f0bee78abc"},"content":[{"type":"text","text":"Обязательна для всех проживающих в кампус-отелях. Мы считаем, что у студента есть вакцина, если есть подтвержденная информация о двух прививках."}]},{"type":"paragraph","attrs":{"id":"af525315-0c70-468c-aed6-e88eda7e86c1"},"content":[{"type":"text","text":"Если данных о вакцине нет, предоставь результат анализа крови на антитела, который подтвердит наличие иммунитета (положительный титр специфических противокоревых антител)."}]},{"type":"paragraph","attrs":{"id":"1cfb8645-ae5d-4286-b668-048b8aaeb886"},"content":[{"type":"text","text":"Если у тебя есть противопоказания к вакцине, предоставь справку о медицинском отводе."}]}]}]},{"type":"horizontal_rule","attrs":{"id":"804a8502-e99f-4f6f-bcd7-51f3ed039c45"}},{"type":"paragraph","attrs":{"id":"ed17b1bc-e768-48be-87b1-36a3be647716"},"content":[{"type":"text","text":"Если у тебя остались вопросы, напиши своему куратору в Time.","marks":[{"type":"italic"}]}]},{"type":"heading","attrs":{"id":"e7788e29-fc91-4617-8112-2996e0c4f0ac","level":2},"content":[{"type":"text","text":"Читай также","marks":[{"type":"bold"}]}]}]},{"type":"layoutSection","attrs":{"id":"1d355e6b-7f33-4499-ac55-4084bb6da5f4"},"content":[{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"67a3be22-c61b-49b2-8e33-8b192c688fb0","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"838a8a1c-00d4-4446-9336-989bd8d80a35"},"content":[{"type":"text","text":"Как прикрепиться к поликлинике","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/8dd0452c-892d-4b13-adb6-938b3ebf989e"}},{"type":"bold"}]}]}]}]},{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"1879da34-c524-42b5-bd9d-ec638953c450","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"8ccd3fe4-3fb4-453c-a15c-f4d10b2ac0fc"},"content":[{"type":"text","text":"Как получить полис ОМС","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/bdb59c08-3508-4f06-bf01-3a2170e73346"}},{"type":"bold"}]}]}]}]}]},{"type":"layoutSection","attrs":{"id":"7601b603-09c7-4e95-b09b-330ae755d6ae"},"content":[{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"c34180de-1410-4ae6-bb67-b83f97d76a06","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"d29b3e4c-7407-47fb-a277-07c133862fa9"},"content":[{"type":"text","text":"Психологи","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/0fdd6062-2ae4-4a8a-b90c-d8282a51556e"}},{"type":"bold"}]}]}]}]},{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"ed4784b6-67b0-4d27-93b6-e155712c24e6","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"915e01cd-36ad-4709-ba80-af50baa10861"},"content":[{"type":"text","text":"Медицинская помощь","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/21d672f4-0232-4500-a32e-23b8ce4803c6"}},{"type":"bold"}]}]}]}]}]}]}