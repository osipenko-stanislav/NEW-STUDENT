7921-4baa-9e48-38c43f759376"},"content":[{"type":"paragraph","attrs":{"id":"77fb2abf-1af8-4c6d-abcd-b1fb1425b35c"},"content":[{"type":"text","text":"Проверяй настройки восстановления: номер и контрольные вопросы должны быть актуальными."}]}]},{"type":"list_item","attrs":{"id":"86a619f5-df0f-4d0b-adaa-ac560d068a14"},"content":[{"type":"paragraph","attrs":{"id":"a5d2711b-ee1e-448e-9b62-aa7a4f30d430"},"content":[{"type":"text","text":"Просматривай историю входов в важные аккаунты.  "}]}]},{"type":"list_item","attrs":{"id":"8e973782-7b82-4074-b64b-d643dd51ec38"},"content":[{"type":"paragraph","attrs":{"id":"51e32a7c-b2f1-433a-b07a-ef6fdbd4a929"},"content":[{"type":"text","text":"Отзывай доступ у сторонних приложений, если больше не пользуешься ими.  "}]}]}]},{"type":"heading","attrs":{"id":"a0445ffe-4a5a-4af8-92ed-fa2ea41b2b64","level":2},"content":[{"type":"text","text":"Защита от фишинга и мошенничества","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"c7906f26-8bcf-4095-a811-0d6aa6bb65f2"},"content":[{"type":"hardBreak"},{"type":"text","text":"Как выглядит фишинг","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"c2ac7a1c-1a52-4685-9390-8219a763c60f"},"content":[{"type":"list_item","attrs":{"id":"3bf48f11-5bd5-4c1a-b3a5-1c758bb9108a"},"content":[{"type":"paragraph","attrs":{"id":"c3c598a1-5479-4c8f-8a8e-657ecd82654a"},"content":[{"type":"text","text":"Сообщения с угрозами и срочностью. Например, «аккаунт заблокируют через 10 минут»."}]}]},{"type":"list_item","attrs":{"id":"4acad76f-fe00-415d-8010-33e8267849a9"},"content":[{"type":"paragraph","attrs":{"id":"fc42b682-6763-41fd-8c43-4ef62f7e3bff"},"content":[{"type":"text","text":"Грамматические ошибки в письмах от известных сервисов."}]}]},{"type":"list_item","attrs":{"id":"f4baed06-33a6-46e5-90d4-aa666b3662a1"},"content":[{"type":"paragraph","attrs":{"id":"45c17eb5-ad1c-4f65-9911-df787c1851f0"},"content":[{"type":"text","text":"Подозрительные ссылки. Наводи на них курсор, чтобы увидеть р