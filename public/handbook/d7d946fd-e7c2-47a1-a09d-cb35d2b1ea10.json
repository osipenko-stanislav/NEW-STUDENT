-46f5-bbcb-0e7d1c424c85","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"1c54ac03-c6ef-4682-8dfd-a9e38f0d4651"},"content":[{"type":"text","text":"В каждом номере"}]}]}]},{"type":"table_row","attrs":{"id":"3fe44b21-5342-4181-86d3-b7f48e096c11"},"content":[{"type":"table_cell","attrs":{"id":"4e8d4f79-379f-4169-a710-fa81d17d92d0","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"38d2bbc9-1b05-4f70-acb2-b44bbe2e4c1a"},"content":[{"type":"text","text":"«Космос. ВДНХ»"}]}]},{"type":"table_cell","attrs":{"id":"cdc9364e-c466-437d-bfc5-2689206942fc","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"6f2dc216-e9eb-4046-8705-e1d8f4c26e2a"},"content":[{"type":"text","text":"Зона для разогрева еды на 18-м этаже"}]}]}]},{"type":"table_row","attrs":{"id":"7e227807-8065-4381-a303-7b2af18f6e12"},"content":[{"type":"table_cell","attrs":{"id":"73448cb3-5a2f-4372-ae8f-9c8708c288c2","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"819d0e00-7c6f-4ec5-b2b0-8c3028c034c8"},"content":[{"type":"text","text":"«Байкал»"}]}]},{"type":"table_cell","attrs":{"id":"0a713e89-2975-406c-91a4-a43168ccb379","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"7a0e4637-a383-4035-a871-c4a974c58641"},"content":[{"type":"text","text":"На 1-м этаже в корпусах 1 и 2"}]}]}]},{"type":"table_row","attrs":{"id":"1689e514-ca58-4586-9670-80e6057752aa"},"content":[{"type":"table_cell","attrs":{"id":"95f89d15-01ff-4a18-bf7d-da3f9b4f6328","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"95f2c6d0-7c93-4072-8e97-3cc2053e8ab7"},"content":[{"type":"text","text":"«Диск»"}]}]},{"type":"table_cell","attrs":{"id":"50a3ed61-3f7d-4571-999a-a92f2c241080","colspan":1,"rowspan":1},"content":[{"type":"paragraph","attrs":{"id":"04fe60b2-8f46-4504-bcb3-0c16211c8884"},"content":[{"type":"text","text":"Общие кухни на этажах и кухонный гарнитур внутри блока для хранения еды"}]}]}]}]},{"type":"paragraph","attrs":{"id":"d1079170-4bf6-4c53-918e-fa2fed0019f7"},"content":[{"type":"text","text":"Все продукты в общем холодильнике или морозильной камере должны быть промаркированы. Подойдет заводская упаковка с датой или стикер, на котором указаны:"}]},{"type":"bullet_list","attrs":{"id":"ddd6f936-2304-4b95-b0a7-6d2ef1b039d2"},"content":[{"type":"list_item","attrs":{"id":"fdb31ce0-3897-4fcb-8c6e-c009a99595ad"},"content":[{"type":"paragraph","attrs":{"id":"cb2ab2eb-cb49-416d-b4e6-8d009a551fd7"},"content":[{"type":"text","text":"фамилия"}]}]},{"type":"list_item","attrs":{"id":"a7fa91a5-31f7-41e4-bf6a-4c67e5eec1cb"},"content":[{"type":"paragraph","attrs":{"id":"ce6a5897-1605-462d-9831-917690b6be5e"},"content":[{"type":"text","text":"номер комнаты"}]}]},{"type":"list_item","attrs":{"id":"16faa635-6519-4dac-9891-e7af78932727"},"content":[{"type":"paragraph","attrs":{"id":"9ec3e6aa-d4a6-4803-accc-12b83a2cd073"},"content":[{"type":"text","text":"дата утилизации продукта"}]}]}]},{"type":"paragraph","attrs":{"id":"c74b4d77-fc37-4f6c-a6b4-3452813300b3"},"content":[{"type":"text","text":"Скотч и маркер есть возле каждого холодильника."}]},{"type":"panel","attrs":{"id":"67c4cf51-6b71-46b2-a854-eb0bfb2c4ef2","type":"warning"},"content":[{"type":"paragraph","attrs":{"id":"98e33420-57df-4e57-a3fc-081a58b9bc92"},"content":[{"type":"text","text":"Сотрудники клининга проверяют холодильники каждый понедельник, а морозильные камеры — каждый первый понедельник месяца. Продукты без маркировки или с истекшим сроком годности утилизируют вместе с тарой."}]}]},{"type":"heading","attrs":{"id":"2dfc7c6c-8212-4935-9b1f-fb40ce56b056","level":2},"content":[{"type":"text","text":"Сантехника и электроприборы","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"73096351-e770-42e2-879e-a7e3b6f7da3f"},"content":[{"type":"text","text":"Бережно относись к сантехнике. Если из-за неправильного использования возникнет засор или поломка, тебе придется возместить ущерб."}]},{"type":"paragraph","attrs":{"id":"2702c014-02ea-4565-9737-3a670e910dc0"},"content":[{"type":"text","text":"Пользуйся только исправными и разрешенными электроприборами. Не включай нагревательные приборы без исправного термостата или защиты от перегрева."}]},{"type":"panel","attrs":{"id":"e0322a3d-9405-4d7f-8536-221b954afac1","type":"warning"},"content":[{"type":"paragraph","attrs":{"id":"1a0a9c23-3325-489f-9bbc-7805d6a958b3"},"content":[{"type":"text","text":"Если заметишь неисправность, не пытайся устранить ее самостоятельно — сразу сообщи администрации"}]}]},{"type":"heading","attrs":{"id":"2d93756d-9532-4ba7-9053-57d1ef5f5ad5","level":2},"content":[{"type":"text","text":"Пожарная сигнализация","marks":[{"type":"bold"}]}]},{"type":"layoutSection","attrs":{"id":"3f01642c-c3f7-498d-86cd-43b3429071a1"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"23191ee4-7a46-4952-afa3-c6bd5d3fb7ff"},"content":[{"type":"text","text":"Пожарные датчики могут сработать не только из-за дыма, но и из-за пара, горячего воздуха или сухих аэрозолей."}]},{"type":"paragraph","attrs":{"id":"d106c150-e104-466b-bf65-14e44005fd6e"},"content":[{"type":"text","text":"Если сигнализация включится, сигнал автоматически передастся дежурному МЧС. Ложный вызов могут расценить как "},{"type":"text","text":"административное правонарушение","marks":[{"type":"bold"}]},{"type":"text","text":", поэтому следи, чтобы в датчики не попадало ничего лишнего."}]},{"type":"paragraph","attrs":{"id":"899a2361-4721-477c-ba9d-86c4698db290"},"content":[{"type":"text","text":"Если сигнализация уже сработала","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"3e3973c8-fb86-48d1-be8d-85c9228cb8ee"},"content":[{"type":"text","text":"Не паникуй и открой окно настежь. Если задымление произошло во время готовки, убери все с плиты и выключи ее."}]},{"type":"paragraph","attrs":{"id":"ecd4c80d-913b-439e-95a3-116570606ad2"},"content":[{"type":"text","text":"Сообщи администратору или охране, почему сработала сигнализация."}]}]},{"type":"layoutColumn","content":[{"type":"mediaWrapper","attrs":{"id":"bfa7c0d3-d1cf-46b7-8710-8d0b95a1f067"},"content":[{"type":"media","attrs":{"id":"0303cb0c-abfe-42a3-b558-667e9c070791","_meta":{"title":"пожарная сигнализация.png","size":349184,"simpleType":"image"},"_mimetype":"image/png","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=0303cb0c-abfe-42a3-b558-667e9c070791&source_id=d7d946fd-e7c2-47a1-a09d-cb35d2b1ea10&source_type=article&bx_token=&account_slug=default"}}]}]}]},{"type":"heading","attrs":{"id":"413f6488-cd4d-4c35-bd7b-c19c05c97678","level":2},"content":[{"type":"text","text":"Мероприятия и встречи","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"1d36a924-48f2-4bc5-bd91-d44f200a0508"},"content":[{"type":"text","text":"Если ты хочешь провести день рождения, встречу клуба или другое мероприятие, согласуй его с администрацией кампус-отеля не позднее чем за две недели."}]},{"type":"paragraph","attrs":{"id":"f1e836a0-a777-4557-8a91-9e68c8dc5a86"},"content":[{"type":"text","text":"В заявке укажи:","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"aede3f7b-1b9f-4961-b166-465fa8192419"},"content":[{"type":"list_item","attrs":{"id":"fef07c3a-0159-4646-8261-933aaab2ac94"},"content":[{"type":"paragraph","attrs":{"id":"f22e5e85-7636-4f4a-9efa-5363829bca92"},"content":[{"type":"text","text":"формат мероприятия"}]}]},{"type":"list_item","attrs":{"id":"2b3c3651-386c-4c86-9b12-88d2d8c7279c"},"content":[{"type":"paragraph","attrs":{"id":"42ba536c-4a54-4a55-ab14-8f5d5796e12b"},"content":[{"type":"text","text":"дату и время"}]}]},{"type":"list_item","attrs":{"id":"b34b4c11-8e32-4f5c-b658-8ccd873fae4b"},"content":[{"type":"paragraph","attrs":{"id":"266ee118-1964-4e24-b6db-fa8316930014"},"content":[{"type":"text","text":"место проведения"}]}]},{"type":"list_item","attrs":{"id":"422d5ed0-cb7f-487c-be76-6321adb8ab53"},"content":[{"type":"paragraph","attrs":{"id":"1cfd04b5-9706-4f29-8690-c68d591801c5"},"content":[{"type":"text","text":"предполагаемое количество участников"}]}]}]},{"type":"paragraph","attrs":{"id":"85fe695d-9ead-4f9f-8428-499ec86acde3"},"content":[{"type":"text","text":"Обычный визит одного или нескольких гостей мероприятием не считается, но для каждого посетителя все равно действуют правила гостевого доступа."}]},{"type":"heading","attrs":{"id":"4b233434-3ed2-459a-a9cc-bd07dd032f07","level":2},"content":[{"type":"text","text":"Что нельзя делать","marks":[{"type":"bold"}]}]},{"type":"layoutSection","attrs":{"id":"27341a76-2f77-4300-b07f-296243cbf3d9"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"80bd4553-7525-4b0d-a05b-43cd61103022"},"content":[{"type":"text","text":"Самостоятельно менять или устанавливать замки. "}]},{"type":"paragraph","attrs":{"id":"0d20a58d-3811-4179-a0bb-924456612301"},"content":[{"type":"text","text":"Переносить мебель и другое имущество из комнаты. Делать перепланировку без разрешения администрации."}]},{"type":"paragraph","attrs":{"id":"36f89903-51c9-48f9-8bb4-f985726e6f1a"},"content":[{"type":"text","text":"Передавать ключи другим людям"}]},{"type":"paragraph","attrs":{"id":"27bea9fe-55fb-467f-8da0-19b755456597"},"content":[{"type":"text","text":"Поселять в комнате гостей или других студентов."}]},{"type":"paragraph","attrs":{"id":"05a9e6aa-9ec6-46e9-a3e4-6475f5abc913"},"content":[{"type":"text","text":"Использовать комнату как склад, мастерскую, офис или торговую точку."}]},{"type":"paragraph","attrs":{"id":"b8b7fa01-6626-490d-bd85-b6492a01d067"},"content":[{"type":"text","text":"Размещать объявления, плакаты и другие материалы без согласования."}]},{"type":"paragraph","attrs":{"id":"650b29aa-fb4f-4619-8285-64c3fd607953"},"content":[{"type":"text","text":"Устанавливать оборудование, которое меняет фасад или общие пространства."}]},{"type":"paragraph","attrs":{"id":"8b378570-59a6-4a13-b29f-dfa42bfdfde9"},"content":[{"type":"text","text":"Заводить домашних животных."}]},{"type":"paragraph","attrs":{"id":"8311dfee-6fc1-48d7-95d7-b488f9ab27c6"},"content":[{"type":"text","text":"Играть в азартные игры."}]}]},{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"949ee879-0c99-4723-870c-8269bb1dd9cf"},"content":[{"type":"text","text":"Употреблять и хранить алкоголь. Находиться в состоянии алкогольного, наркотического или токсического опьянения."}]},{"type":"paragraph","attrs":{"id":"79533805-5a35-43b0-82fa-d49023c9594c"},"content":[{"type":"text","text":"Хранить, употреблять или распространять наркотические и токсические вещества."}]},{"type":"paragraph","attrs":{"id":"41b7735b-d16e-47df-a988-d4b0bf324143"},"content":[{"type":"text","text":"Курить сигареты, вейпы, электронные сигареты и другие курительные устройства."}]},{"type":"paragraph","attrs":{"id":"22d8920f-d2a9-476f-a21a-e00ed26b7902"},"content":[{"type":"text","text":"Приносить оружие и его муляжи, даже при наличии разрешения"}]},{"type":"paragraph","attrs":{"id":"56d0d875-2611-4fb2-8b50-6659d97821f0"},"content":[{"type":"text","text":"Хранить взрывчатые, легковоспламеняющиеся или опасные химические вещества."}]},{"type":"paragraph","attrs":{"id":"4e2a48b9-a7a9-45ac-bf3b-948eec3ab8c3"},"content":[{"type":"text","text":"Использовать открытый огонь."}]},{"type":"paragraph","attrs":{"id":"63df95d4-5e0b-4f09-98fb-aa7d28c753ae"},"content":[{"type":"text","text":"Заниматься торговлей, проводить платные занятия, размещать рекламу или вести политическую и религиозную агитацию."}]}]}]},{"type":"heading","attrs":{"id":"3cee787a-be76-48fc-8dc8-ebd35fa2472f","level":2},"content":[{"type":"text","text":"С какими вопросами куда обращаться","marks":[{"type":"bold"}]}]},{"type":"layoutSection","attrs":{"id":"97756bb9-8330-4a34-938f-377abbbaca78"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"458c74a2-26ff-4f1b-b87d-c9f18df9ae10"},"content":[{"type":"text","text":"Бот «Маяк» в Time","marks":[{"type":"link","attrs":{"href":"https://time.cu.ru/tsentralnyy-universitet/messages/@mayak_suppo