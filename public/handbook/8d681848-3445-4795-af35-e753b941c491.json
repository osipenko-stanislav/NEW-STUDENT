{"type":"doc","content":[{"type":"doc","content":[{"type":"layoutSection","attrs":{"id":"02f798c2-e4a4-451a-ae35-4f79b147e1a8"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"d499d23e-c6ea-4a51-8792-55027efde725"},"content":[{"type":"text","text":"Общие договоренности о жизни в кампус-отелях, которые разработали студенты ЦУ. Он помогает организовать быт, пользоваться общими пространствами и учитывать интересы соседей. "}]},{"type":"paragraph","attrs":{"id":"bd88f81e-0796-4df6-994f-122139211498"},"content":[{"type":"text","text":"Правила можно пересматривать, если меняются потребности сообщества."}]}]}]},{"type":"heading","attrs":{"id":"c7f827b5-7603-41af-8aa4-d1651acb23f3","level":2},"content":[{"type":"text","text":"Прачечная","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"43c5471a-f151-47dc-8c8f-0d1f2e4cede0"},"content":[{"type":"list_item","attrs":{"id":"e5d9511a-044c-436f-a334-880254dc12ad"},"content":[{"type":"paragraph","attrs":{"id":"bc82e8a3-095e-4b90-9ea4-e4d5059736e5"},"content":[{"type":"text","text":"Не оставляй вещи после сушки или стирки, забирай их сразу. "}]}]},{"type":"list_item","attrs":{"id":"50e3f239-7b39-4759-a1d7-e97fb2047119"},"content":[{"type":"paragraph","attrs":{"id":"3a3ffe2c-de0a-4d47-871f-e278cfa2d912"},"content":[{"type":"text","text":"Если тебе нужно загрузить вещи, а свободной стиральной или сушильной машины нет, переложи чистые вещи из барабана в пластиковый контейнер. "}]}]},{"type":"list_item","attrs":{"id":"689b332f-e783-49b0-be87-289cc1a7572b"},"content":[{"type":"paragraph","attrs":{"id":"f14d7add-2116-4738-bf0f-b136870ba341"},"content":[{"type":"text","text":"Если пластиковые контейнеры заполнены, напиши в чат кампус-отеля, попроси забрать вещи. "}]}]},{"type":"list_item","attrs":{"id":"9d198eb2-a6ba-4393-a955-8c98efacabfb"},"content":[{"type":"paragraph","attrs":{"id":"26f0384e-5698-4ee0-a4d6-1238d665fdb5"},"content":[{"type":"text","text":"Каждый понедельник сотрудники клининга будут убирать вещи из мест общего пользования в одну корзину, которая будет находиться в багажном отделении неделю. Чтобы забрать свои вещи, обратись на ресепшен. Если за неделю вещи не забрали, они будут утилизированы."}]}]},{"type":"list_item","attrs":{"id":"ea5b1586-c6c2-40b5-932b-613b928f1475"},"content":[{"type":"paragraph","attrs":{"id":"37422ebd-a86c-4440-b97a-434bef221a16"},"content":[{"type":"text","text":"Администрация отеля и университета не несет ответственности за утерянные вещи."}]}]}]},{"type":"layoutSection","attrs":{"id":"8f73686c-a0a8-4238-ac15-ed639cf3460c"},"content":[{"type":"layoutColumn","content":[{"type":"mediaWrapper","attrs":{"id":"d0998192-c2a2-40cf-a46a-13f74ebf7b29"},"content":[{"type":"media","attrs":{"id":"ecf410c1-ba7b-40d4-9834-79931e360951","_meta":{"title":"Как_пользоваться_стиральной_машиной.pdf","size":240640,"simpleType":"application"},"_mimetype":"application/pdf","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=ecf410c1-ba7b-40d4-9834-79931e360951&source_id=8d681848-3445-4795-af35-e753b941c491&source_type=article&bx_token=&account_slug=default"}}]}]},{"type":"layoutColumn","content":[{"type":"mediaWrapper","attrs":{"id":"3306ead3-ddd8-4227-9ec0-c401b3acf348"},"content":[{"type":"media","attrs":{"id":"22cfaf39-b00d-4beb-b2d5-e0c0bc3fb287","_meta":{"title":"Как_пользоваться_сушильной_машиной.pdf","size":293888,"simpleType":"application"},"_mimetype":"application/pdf","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=22cfaf39-b00d-4beb-b2d5-e0c0bc3fb287&source_id=8d681848-3445-4795-af35-e753b941c491&source_type=article&bx_token=&account_slug=default"}}]}]}]},{"type":"heading","attrs":{"id":"05183ced-9d1d-412c-a189-430ebfce2f7b","level":2},"content":[{"type":"text","text":"Кухня","marks":[{"type":"bold"}]}]},{"type":"layoutSection","attrs":{"id":"dd04ca99-ba43-41c3-951c-d70fc41a1e44"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"5a464728-8b60-4a9d-ba65-15dd37797446"},"content":[{"type":"text","text":"Грязная посуда","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"df36204f-2398-4ea2-9a68-0da48f289288"},"content":[{"type":"list_item","attrs":{"id":"3be29053-1d3c-4692-b664-46ebf868553c"},"content":[{"type":"paragraph","attrs":{"id":"ff7c2db9-9937-4225-b0e5-ac50f6f82a47"},"content":[{"type":"text","text":"Не оставляй грязную посуду в местах общего пользования: на обеденных столах, разделочных поверхностях, в шкафах, раковине, холодильнике."}]}]},{"type":"list_item","attrs":{"id":"7036244d-7efa-4cb7-bf12-fc7824ca8f5d"},"content":[{"type":"paragraph","attrs":{"id":"fb38eed3-cd05-4e79-8742-4ec0626b99e6"},"content":[{"type":"text","text":"Если заметишь чужую грязную посуду, положи ее в специальный пластиковый бокс. "}]}]},{"type":"list_item","attrs":{"id":"feaf9c6d-fbba-4f42-8620-9fb89bdde8d4"},"content":[{"type":"paragraph","attrs":{"id":"87c2fd7c-7a51-42a5-85fb-777ec97ec888"},"content":[{"type":"text","text":"Каждое утро во время уборки сотрудники клининга будут утилизировать содержимое бокса."}]}]}]},{"type":"mediaWrapper","attrs":{"id":"56ca6e46-4c38-4f8a-8e3d-8f53f1eeee53"},"content":[{"type":"media","attrs":{"id":"fa8413af-1d54-474e-a9b1-a41660e3493b","_meta":{"title":"Как пользоваться микроволновкой.pdf","size":205824,"simpleType":"application"},"_mimetype":"application/pdf","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=fa8413af-1d54-474e-a9b1-a41660e3493b&source_id=8d681848-3445-4795-af35-e753b941c491&source_type=article&bx_token=&account_slug=default"}}]}]},{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"571cf80e-be4c-4c9b-a03e-4b9989e8c663"},"content":[{"type":"text","text":"Холодильник","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"11ed23ea-daea-438b-aefe-4bad5a8a2bb2"},"content":[{"type":"list_item","attrs":{"id":"975c09d5-46b3-4f5d-9e70-94ed2a19abfa"},"content":[{"type":"paragraph","attrs":{"id":"caf337df-a570-4195-b91d-20343e8de276"},"content":[{"type":"text","text":"Вся еда должна быть промаркирована. Это могут быть заводская маркировка или стикер с твоей "},{"type":"text","text":"фамилией, номером комнаты и датой утилизации","marks":[{"type":"bold"}]},{"type":"text","text":". Скотч и маркер есть возле каждого холодильника. "}]}]},{"type":"list_item","attrs":{"id":"a4d54d5f-17e5-463b-b3ac-d7b2cd973a44"},"content":[{"type":"paragraph","attrs":{"id":"898f2026-15ad-49ff-8f40-418e878f7a8f"},"content":[{"type":"text","text":"Каждый понедельник клининг проверяет холодильники, а в первый понедельник месяца — морозильные камеры. Продукты без маркировки и с истекшим сроком годности выбрасывают вместе с упаковкой."}]}]}]},{"type":"mediaWrapper","attrs":{"id":"b96054c7-f8c4-4651-a86b-ada149a7cb63"},"content":[{"type":"media","attrs":{"id":"d0659129-4e49-4131-ab43-b765e6401e55","_meta":{"title":"Как пользоваться холодильником.pdf","size":143360,"simpleType":"application"},"_mimetype":"application/pdf","src":"https://note.cu.ru/api/v1/upload/editor/view?file_id=d0659129-4e49-4131-ab43-b765e6401e55&source_id=8d681848-3445-4795-af35-e753b941c491&source_type=article&bx_token=&account_slug=default"}}]}]}]},{"type":"heading","attrs":{"id":"5d2a09fe-7a06-451b-897a-282686ae29d3","level":2},"content":[{"type":"text","text":"Клининг","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"a8791daf-ac1e-4b50-b6e0-ac620bb693f1"},"content":[{"type":"text","text":"Ответственность за уборку делится между студентами и сотрудниками клининга. Помни, что ты всегда можешь обратиться на ресепшен, если сотрудники клининга не выполняют своих обязанностей. "}]},{"type":"panel","attrs":{"id":"7b1f17c2-82a6-4589-9aba-d3399f0c00df","type":"warning"},"content":[{"type":"paragraph","attrs":{"id":"edd7ff9c-67b4-4b6b-9079-0517f7783ebf"},"content":[{"type":"text","text":"Сотрудники клининга могут направить информацию о нарушении правил проживания ответственному в ЦУ."}]}]},{"type":"layoutSection","attrs":{"id":"2d3867d8-a0ae-4a10-9d0f-e3986b637ad5"},"content":[{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"3c80e522-1cfd-405a-a7f0-fa4e9582575a"},"content":[{"type":"text","text":"Зоны ответственности студентов","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"8d3e6955-5652-499d-a085-4cc605390f47"},"content":[{"type":"list_item","attrs":{"id":"627335ff-8801-4b06-9d49-b8172c70771a"},"content":[{"type":"paragraph","attrs":{"id":"e8f09115-5781-4ec5-a7ac-34dac561317f"},"content":[{"type":"text","text":"Освободить комнату для уборки по графику или договориться с клинером, чтобы остаться в комнате."}]}]},{"type":"list_item","attrs":{"id":"3ad33d44-b6eb-4733-a2a3-e7e6efdf2738"},"content":[{"type":"paragraph","attrs":{"id":"b666d11c-b6d0-4d94-a9b2-ced6d5a7d64e"},"content":[{"type":"text","text":"Убрать вещи с кровати, чтобы не мешать менять постельное белье."}]}]},{"type":"list_item","attrs":{"id":"21c9a80e-b98a-41c7-a8bf-443539f074db"},"content":[{"type":"paragraph","attrs":{"id":"b5d43203-c9a9-4ddb-82a1-02006fd40508"},"content":[{"type":"text","text":"Освободить пол от вещей, чтобы не мешать влажной уборке."}]}]}]},{"type":"panel","attrs":{"id":"9fbf2fa8-d266-48b7-bf16-d0d2ccf7512d","type":"warning"},"content":[{"type":"paragraph","attrs":{"id":"437859a8-0d56-4290-9070-b2702395b4c6"},"content":[{"type":"text","text":"Крупногабаритные вещи, например чемоданы, оставь в камере хранения."}]}]}]},{"type":"layoutColumn","content":[{"type":"paragraph","attrs":{"id":"4708d356-dfa8-49a9-9c59-6b5ca67ba293"},"content":[{"type":"text","text":"Зоны ответственности клининга","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"be4b297d-bdc5-41d3-9e91-a1e416e5ace1"},"content":[{"type":"list_item","attrs":{"id":"602c2110-5440-4158-b334-3e083605893a"},"content":[{"type":"paragraph","attrs":{"id":"cc6ec1f7-c136-4d4e-9b3e-3e4005834271"},"content":[{"type":"text","text":"Проводить влажную уборку пола и поверхностей (стола)."}]}]},{"type":"list_item","attrs":{"id":"3bc6e8bc-26da-43f0-9d44-f904902b9c77"},"content":[{"type":"paragraph","attrs":{"id":"aa289386-8d97-45a9-b885-d3cab52f8b31"},"content":[{"type":"text","text":"Менять постельное белье и полотенца."}]}]},{"type":"list_item","attrs":{"id":"1d724025-70a7-4caf-9bac-cd935fd7ee5b"},"content":[{"type":"paragraph","attrs":{"id":"9acb141a-accf-4fed-8e06-96e365a450bf"},"content":[{"type":"text","text":"Мыть ванную комнату."}]}]},{"type":"list_item","attrs":{"id":"25d7f137-3c0f-4332-92a9-9ee09209e51f"},"content":[{"type":"paragraph","attrs":{"id":"d340ddc3-6168-4a33-8dd2-d4d4e3c721ac"},"content":[{"type":"text","text":"Пополнять запасы мыла для рук и туалетной бумаги."}]}]},{"type":"list_item","attrs":{"id":"f42e1dcd-339f-47c0-a2ca-c2641daa9100"},"content":[{"type":"paragraph","attrs":{"id":"3382ad97-860e-4ee5-a207-6c338eb59d17"},"content":[{"type":"text","text":"Выносить мусор из мусорного ведра."}]}]}]},{"type":"panel","attrs":{"id":"05708dd4-4aed-4db5-a618-166658cb5b2b","type":"warning"},"content":[{"type":"paragraph","attrs":{"id":"9c4a5489-3af7-46f6-9673-25ebbbe1bab7"},"content":[{"type":"text","text":"Клининг не моет грязную посуду, не выносит крупногабаритный мусор или мусорные пакеты не из мусорного ведра."}]}]}]}]},{"type":"heading","attrs":{"id":"00c3fac0-4c0c-4b3e-bc7f-6d9e9fce999d","level":2},"content":[{"type":"text","text":"Нарушение кодекса","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"73cf1533-44b8-4392-97a1-75f2c2fdc9e9"},"content":[{"type":"list_item","attrs":{"id":"fcddece1-ce94-4900-955c-2310ab5c9617"},"content":[{"type":"paragraph","attrs":{"id":"dca4fe1e-809e-4420-8fd8-57574fcc5296"},"content":[{"type":"text","text":"При первом нарушении мы направим тебе сообщение в Time, в котором опишем ситуацию и попросим исправиться."}]}]},{"type":"list_item","attrs":{"id":"64e7f1ad-7f84-4b70-beef-df2bf7751909"},"content":[{"type":"paragraph","attrs":{"id":"0bece5c6-3868-4bba-88fa-f699eee65121"},"content":[{"type":"text","text":"При втором нарушении пригласим тебя на встречу 1-2-1, на которой обсудим правила проживания и трудности, которые у тебя могли возникнуть."}]}]},{"type":"list_item","attrs":{"id":"76f20b9a-c891-47d8-8331-d230c5f8ad94"},"content":[{"type":"paragraph","attrs":{"id":"ab743ee7-a8e8-449f-be81-93ec34d04991"},"content":[{"type":"text","text":"При третьем нарушении придем в твой номер с проверкой. Если не получим ответ после первых нарушений, также назначим проверку."}]}]},{"type":"list_item","attrs":{"id":"4fc1e95a-fc7d-4641-bf68-68dee173c763"},"content":[{"type":"paragraph","attrs":{"id":"1247ff12-1db1-4597-ac35-6a23da90a558"},"content":[{"type":"text","text":"При четвертом нарушении организуем дисциплинарную комиссию. На ней могут ввести ограничения: от запрета участвовать в конкурсе на место в кампус-отеле до выселения."}]}]}]},{"type":"heading","attrs":{"id":"51b83db2-eb8e-4d31-8a2e-14b21e7a34c4","level":2},"content":[{"type":"text","text":"Актуальность кодекса","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"5ebb67af-99af-4d4b-9346-55fc53e72289"},"content":[{"type":"text","text":"Мы будем обновлять кодекс в начале каждого учебного года."}]},{"type":"paragraph","attrs":{"id":"a2d741f1-ecaa-4a23-be6c-605d7f8227db"},"content":[{"type":"text","text":"В течение года ты можешь:","marks":[{"type":"bold"}]},{"type":"text","text":" "}]},{"type":"bullet_list","attrs":{"id":"a6c01bac-d591-41d6-b56f-4c4b37b42233"},"content":[{"type":"list_item","attrs":{"id":"ce77d5f7-0520-47a4-abfc-92f14f8135a5"},"content":[{"type":"paragraph","attrs":{"id":"0f7ca5da-edcc-4819-b217-a6983f2135ad"},"content":[{"type":"text","text":"предложить идею по развитию кампус-отеля"}]}]},{"type":"list_item","attrs":{"id":"3271d9f1-054a-4d39-8999-9efa1faf1951"},"content":[{"type":"paragraph","attrs":{"id":"c6d11dd0-8137-4006-ad76-33b71a289408"},"content":[{"type":"text","text":"начать реализовывать свою идеи в рамках развития кампус-отеля"}]}]}]},{"type":"heading","attrs":{"id":"65c29243-ed59-4ff8-9927-94ef37e7c2c3","level":2},"content":[{"type":"text","text":"Читай также","marks":[{"type":"bold"}]}]}]},{"type":"layoutSection","attrs":{"id":"c4e190e1-a894-4d11-b64b-609506c06050"},"content":[{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"abd48151-201a-42ec-827a-02442f7b6362","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"9abedfa5-3d00-4760-ae4b-cc268e0fbd51"},"content":[{"type":"text","text":"Правила проживания","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/d7d946fd-e7c2-47a1-a09d-cb35d2b1ea10"}},{"type":"bold"}]}]}]}]},{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"4c3030cf-d69b-4af5-aaeb-0d80543063f6","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"aabcb72b-05a2-42a4-98e1-bbd05aef3fb4"},"content":[{"type":"text","text":"Заселение в кампус-отели","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/d6ef2831-6e8d-48f1-ba53-01bc8baa2d04"}},{"type":"bold"}]}]}]}]}]},{"type":"layoutSection","attrs":{"id":"a94e2a87-2852-44d2-93db-dd580dcf54df"},"content":[{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"2833cc45-65f9-4593-b30d-a8f55a3c3d10","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"5d921ac6-4e99-492f-a9bd-00a795221e05"},"content":[{"type":"text","text":"Медицинские справки","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/3a61975c-6fed-441e-a604-899f3ba07859"}},{"type":"bold"}]}]}]}]},{"type":"layoutColumn","content":[{"type":"panel","attrs":{"id":"8eb1ed4a-384b-4c82-8984-0c790debb64b","type":"note"},"content":[{"type":"paragraph","attrs":{"id":"9a10940c-c2a3-4a23-87df-22df310adc4d"},"content":[{"type":"text","text":"Кодекс повед","marks":[{"type":"link","attrs":{"href":"/at/603d0c15-164b-41f6-95b3-40111950afc6"}},{"type":"bold"}]},{"type":"text","text":"ения в ЦУ","marks":[{"type":"link","attrs":{"href":"https://note.cu.ru/space/dff5a22f-c6bf-4db2-9138-b7f830e4e921/article/d75b67f7-88ad-442e-a8a4-5f48d9bf3895"}},{"type":"bold"}]}]}]}]}]}]}