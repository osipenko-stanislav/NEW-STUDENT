text","text":"Красная зона","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"id":"9f0287bc-c7ba-4b10-ae25-532fd0cfa3b3"},"content":[{"type":"text","text":"Студенты в красной зоне не получают стипендию в этом семестре."}]},{"type":"paragraph","attrs":{"id":"5e8c9ca5-f019-48a8-b922-d8a007d8c04d"},"content":[{"type":"text","text":"На первом курсе блокерами могут стать:","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"e164ed5f-9990-4dd4-912f-01635bb0b5d9"},"content":[{"type":"list_item","attrs":{"id":"c7b1f3e6-485e-41dd-ae69-cf3fe5c103a0"},"content":[{"type":"paragraph","attrs":{"id":"d44087c1-2dbc-4703-80fc-48a415e5e4b9"},"content":[{"type":"text","text":"пересдачи"}]}]},{"type":"list_item","attrs":{"id":"a4c0a643-7dd1-4401-969c-9526ed4980ab"},"content":[{"type":"paragraph","attrs":{"id":"754189bd-cbfc-498c-bceb-bae55b72d698"},"content":[{"type":"text","text":"желтая карточка за нарушение академической честности"}]}]},{"type":"list_item","attrs":{"id":"fcf20b70-1417-4fa1-9fba-c241f3442979"},"content":[{"type":"paragraph","attrs":{"id":"8485e774-3161-4df3-9d41-19ea4493e8fd"},"content":[{"type":"text","text":"итоговые тройки — решение зависит от общего распределения студентов по успеваемости"}]}]}]},{"type":"paragraph","attrs":{"id":"47d97071-e8f7-4b75-80b5-5737d277c6ac"},"content":[{"type":"text","text":"На втором курсе блокерами становятся:","marks":[{"type":"bold"}]}]},{"type":"bullet_list","attrs":{"id":"582f4037-8ff6-4fb2-ba37-0e8e4e7ad858"},"content":[{"type":"list_item","attrs":{"id":"6ef51080-e810-4f35-9395-39537f63f4f0"},"content":[{"type":"paragraph","attrs":{"id":"17f91c2f-ca2a-4a90-8e18-f1970cad27c0"},"content":[{"type":"text","text":"пересдачи, кроме случаев, когда на пересдачу по конкретному предмету вышло много студентов"}]}]},{"type":"list_item","attrs":{"id":"6850d1ff-f694-47a6-b2e9-6a9e7a70fb95"},"content":[{"type":"paragraph","attrs":{"id":"a3798079-e588-4090-833c-23d92613c156"},"content":[{"type":"text","text":"желтая карто